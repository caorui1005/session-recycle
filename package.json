{
  "name": "session-recycle",
  "version": "1.0.0",
  "type": "module",
  "description": "DSH plugin: session recycle bin — pending-delete with file manifest, restore, purge now or after 7 days.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caorui1005/session-recycle.git"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
